# Supabase: Project Settings > API. Never commit actual keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Frontend (same values, Vite exposes only the publishable key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Comma-separated frontend addresses allowed to call the API.
PM_COPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
